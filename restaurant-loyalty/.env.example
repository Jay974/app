# Base MongoDB dédiée à ce projet (peut être le même cluster que le reste, DB différente)
MONGO_URL=mongodb://localhost:27017
DB_NAME=restaurant_loyalty

# Signature des tokens (staff + client)
JWT_SECRET=change-me-in-production

# Notifications push (PWA) — générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-restaurant.example
